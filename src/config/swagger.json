{
  "swagger": "2.0",
  "info": {
    "title": "API Restaurante",
    "description": "API para la gestión de clientes, menús, pedidos y autenticación.",
    "version": "1.0.0"
  },
  "host": "localhost:3000",
  "basePath": "/",
  "tags": [
    {
      "name": "Clientes",
      "description": "Operaciones relacionadas con clientes"
    },
    {
      "name": "Menú",
      "description": "Gestión de productos del menú"
    },
    {
      "name": "Pedidos",
      "description": "Registro de pedidos"
    },
    {
      "name": "Detalles de Pedido",
      "description": "Detalle de productos por pedido"
    },
    {
      "name": "Autenticación",
      "description": "Login y seguridad con JWT"
    }
  ],
  "schemes": [
    "http"
  ],
  "securityDefinitions": {
    "bearerAuth": {
      "type": "http",
      "scheme": "bearer",
      "bearerFormat": "JWT"
    }
  },
  "paths": {
    "/": {
      "get": {
        "description": "",
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/clientes/": {
      "get": {
        "tags": [
          "Clientes"
        ],
        "summary": "Obtener todos los clientes",
        "description": "",
        "responses": {
          "200": {
            "description": "Lista de clientes"
          },
          "500": {
            "description": "Internal Server Error"
          }
        }
      },
      "post": {
        "tags": [
          "Clientes"
        ],
        "summary": "Crea un nuevo cliente",
        "description": "",
        "parameters": [
          {
            "in": "body",
            "name": "body",
            "description": "Objeto cliente a crear",
            "required": true,
            "schema": {
              "type": "object",
              "properties": {
                "nombre": {
                  "type": "string",
                  "example": "Juan Perez"
                },
                "correo": {
                  "type": "string",
                  "example": "juan.perez@example.com"
                },
                "contrasena": {
                  "type": "string",
                  "example": "password123"
                }
              },
              "required": ["nombre", "correo", "contrasena"]
            }
          }
        ],
        "responses": {
          "201": {
            "description": "Cliente creado correctamente"
          },
          "400": {
            "description": "Datos inválidos o faltantes"
          },
          "500": {
            "description": "Error al crear cliente"
          }
        }
      }
    },
    "/api/menu/": {
      "get": {
        "tags": [
          "Menú"
        ],
        "summary": "Verifica conexión con la base de datos y lista menú",
        "description": "",
        "responses": {
          "200": {
            "description": "Conexión establecida y datos devueltos desde la tabla menú"
          },
          "500": {
            "description": "Internal Server Error"
          }
        }
      },
      "post": {
        "tags": [
          "Menú"
        ],
        "summary": "Crea un nuevo producto en el menú",
        "description": "",
        "parameters": [
          {
            "in": "body",
            "name": "body",
            "description": "Objeto producto menú a crear",
            "required": true,
            "schema": {
              "type": "object",
              "properties": {
                "nombre": {
                  "type": "string",
                  "example": "Hamburguesa"
                },
                "precio": {
                  "type": "number",
                  "example": 12000
                },
                "descripcion": {
                  "type": "string",
                  "example": "Deliciosa hamburguesa con queso"
                },
                "categoria": {
                  "type": "string",
                  "example": "Comida rápida"
                }
              },
              "required": ["nombre", "precio", "descripcion", "categoria"]
            }
          }
        ],
        "responses": {
          "201": {
            "description": "Producto creado correctamente"
          },
          "500": {
            "description": "Error al crear producto"
          }
        }
      }
    },
    "/api/pedidos/": {
      "get": {
        "tags": [
          "Pedidos"
        ],
        "summary": "Verifica conexión con la base de datos y lista pedidos",
        "description": "",
        "responses": {
          "200": {
            "description": "Conexión establecida y datos devueltos desde la tabla pedido"
          },
          "500": {
            "description": "Internal Server Error"
          }
        }
      },
      "post": {
        "tags": [
          "Pedidos"
        ],
        "summary": "Crea un nuevo pedido (requiere token JWT)",
        "description": "",
        "parameters": [
          {
            "name": "authorization",
            "in": "header",
            "type": "string"
          },
          {
            "in": "body",
            "name": "body",
            "description": "Objeto pedido a crear",
            "required": true,
            "schema": {
              "type": "object",
              "properties": {
                "clienteId": {
                  "type": "integer",
                  "example": 1
                },
                "total": {
                  "type": "number",
                  "example": 45000
                }
              },
              "required": ["clienteId", "total"]
            }
          }
        ],
        "responses": {
          "201": {
            "description": "Pedido creado"
          },
          "401": {
            "description": "Token inválido"
          },
          "403": {
            "description": "Token no proporcionado"
          },
          "500": {
            "description": "Internal Server Error"
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ]
      }
    },
    "/api/detalles/": {
      "get": {
        "tags": [
          "Detalles de Pedido"
        ],
        "summary": "Verifica conexión con la base de datos y lista detalles de pedido",
        "description": "",
        "responses": {
          "200": {
            "description": "Conexión establecida y datos devueltos desde la tabla detalle_pedido"
          },
          "500": {
            "description": "Internal Server Error"
          }
        }
      },
      "post": {
        "tags": [
          "Detalles de Pedido"
        ],
        "summary": "Crea un nuevo detalle de pedido",
        "description": "",
        "parameters": [
 {
        "in": "body",
        "name": "body",
        "description": "Objeto detalle de pedido a crear",
        "required": true,
        "schema": {
          "type": "object",
          "properties": {
            "cantidad": {
              "type": "integer",
              "example": 2
            },
            "subtotal": {
              "type": "number",
              "format": "float",
              "example": 24000.50
            },
            "menu_id_menu": {
              "type": "integer",
              "example": 3
            },
            "pedido_id_pedido": {
              "type": "integer",
              "example": 7
            }
          },
          "required": ["cantidad", "subtotal", "menu_id_menu", "pedido_id_pedido"]
        }
      }
        ],
        "responses": {
          "201": {
            "description": "Detalle de pedido creado correctamente"
          },
          "500": {
            "description": "Error al crear detalle de pedido"
          }
        }
      }
    },
    "/api/login/": {
      "post": {
        "tags": [
          "Autenticación"
        ],
        "summary": "Inicia sesión con correo y contraseña",
        "description": "",
        "parameters": [
          {
            "in": "body",
            "name": "body",
            "description": "Credenciales de login",
            "required": true,
            "schema": {
              "type": "object",
              "properties": {
                "correo": {
                  "type": "string",
                  "example": "usuario@correo.com"
                },
                "contrasena": {
                  "type": "string",
                  "example": "password123"
                }
              },
              "required": ["correo", "contrasena"]
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Token generado exitosamente"
          },
          "401": {
            "description": "Credenciales incorrectas"
          },
          "500": {
            "description": "Error en el servidor"
          }
        }
      }
    }
  }
}
